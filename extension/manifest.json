{
    "manifest_version": 3,
    "name": "Antigravity Universal AI Bridge — Powered by Trignod.ai",
    "version": "2.1.0",
    "description": "Universal Web AI Architect Bridge for Antigravity IDE. Powered by Trignod.ai",
    "content_scripts": [{
        "matches": [
            "https://gemini.google.com/*",
            "https://claude.ai/*",
            "https://chatgpt.com/*",
            "https://chat.openai.com/*",
            "https://chat.deepseek.com/*"
        ],
        "js": ["content.js"]
    }],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Antigravity AI Bridge — Powered by Trignod.ai"
    }
}